# Udyam OS Environment Configuration Template

# Server Configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Model Provider (deterministic | gemini | openai)
# Defaults to 'deterministic' for offline / reproducible execution
LLM_PROVIDER=deterministic

# Optional API Keys (Only required if LLM_PROVIDER is set to external provider)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
